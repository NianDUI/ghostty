# Local deploy target for ./deploy.sh — copy this file to
# `deploy.env` (same directory, gitignored) and replace the
# placeholders below with your real relay host and path.
#
# Either DEPLOY_HOST/DEPLOY_PATH set in the environment OR a non-
# empty deploy.env beside deploy.sh is required; the script refuses
# to run if both are missing.

DEPLOY_HOST="user@relay.example.com"
DEPLOY_PATH="/opt/ghostty-session-sharing/ghostty-web-client/dist/"
