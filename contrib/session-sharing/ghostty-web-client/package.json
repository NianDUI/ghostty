{
  "name": "ghostty-session-sharing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/redaction.test.mjs test/scroll.test.mjs test/appearance.test.mjs test/scrollback.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:copy-wasm": "cp node_modules/ghostty-web/dist/ghostty-vt.wasm android/app/src/main/assets/public/",
    "android:dev": "npm run build && npx cap sync android && npm run android:copy-wasm",
    "android:build": "npm run build && npx cap sync android && npm run android:copy-wasm"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "ghostty-web": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vite": "^7.1.7"
  }
}
