# Local deploy target for ./deploy.sh — copy this file to
# `deploy.env` (same directory, gitignored) and replace the
# placeholders below with your real relay host and path.
#
# DEPLOY_HOST / DEPLOY_PATH are required; the script refuses to run
# if either is missing. SERVICE_NAME is optional and defaults to
# `ghostty-relay`.

DEPLOY_HOST="root@relay.example.com"
DEPLOY_PATH="/opt/ghostty-session-sharing/contrib/session-sharing/relay/"
# SERVICE_NAME="ghostty-relay"
