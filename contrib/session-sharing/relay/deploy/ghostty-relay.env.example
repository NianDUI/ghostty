GHOSTTY_RELAY_HOST=127.0.0.1
GHOSTTY_RELAY_PORT=18080
GHOSTTY_RELAY_OFFLINE_TTL=300
GHOSTTY_RELAY_TOKEN_TTL=300
GHOSTTY_RELAY_ALLOW_PUBLIC_BIND=0
GHOSTTY_RELAY_USER_TOKENS=replace-with-real-user-token
# GHOSTTY_RELAY_USER_TOKENS_FILE=/etc/ghostty-relay.tokens
GHOSTTY_RELAY_ALLOW_USER_TOKEN_CLIENT_ACCESS=0
GHOSTTY_RELAY_STATIC_ROOT=/opt/ghostty-session-sharing/web-client
GHOSTTY_RELAY_MAX_BODY_BYTES=65536
GHOSTTY_RELAY_MAX_SESSIONS=4096
GHOSTTY_RELAY_MAX_CLIENTS_PER_SESSION=8
GHOSTTY_RELAY_MAX_FRAME_BYTES=262144
GHOSTTY_RELAY_RATE_LIMIT_REQUESTS=120
GHOSTTY_RELAY_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is trusted.
# Set this to the reverse-proxy's address so per-client rate limits and access
# logs see real client IPs. Leave empty when running without a reverse proxy;
# in that case the relay only ever uses the socket peer IP.
GHOSTTY_RELAY_TRUSTED_PROXIES=127.0.0.1
# Dedicated admin listener for /healthz, /readyz, /metrics. Bind on loopback
# (or a private interface) so operator endpoints are not part of the public
# attack surface. Set port to 0 to keep these endpoints on the main listener.
GHOSTTY_RELAY_ADMIN_HOST=127.0.0.1
GHOSTTY_RELAY_ADMIN_PORT=18081
# Long-lived WebSocket lifecycle. Defaults: 30 s expiry checks, 30 s ping
# interval, 60 s ping timeout, 1 MiB per-client send buffer.
GHOSTTY_RELAY_TOKEN_EXPIRY_CHECK_SECONDS=30
GHOSTTY_RELAY_PING_INTERVAL_SECONDS=30
GHOSTTY_RELAY_PING_TIMEOUT_SECONDS=60
GHOSTTY_RELAY_CLIENT_SEND_BUFFER_BYTES=1048576
