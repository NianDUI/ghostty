msgid "Region"
msgstr "区域"

#: src/inspector/widgets/pagelist.zig:361
msgid "Top-Left"
msgstr "左上角"

#: src/inspector/widgets/pagelist.zig:362
msgid "Bottom-Right"
msgstr "右下角"

